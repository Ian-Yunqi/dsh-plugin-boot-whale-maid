{
  "name": "dsh-boot",
  "version": "0.3.0",
  "description": "深度求索开场：DSH 深海宫殿与蓝白鲸鱼女仆启动动画，可点击或 Esc 跳过。",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.dsh.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "scripts",
    "docs/assets.json",
    "docs/ART-NOTES.md",
    "docs/ATTRIBUTION.md",
    "README.md",
    "LICENSE",
    "docs/LESSONS.md",
    "docs/MIGRATION.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "boot-animation",
    "splash",
    "whale-maid",
    "whale-girl",
    "maid",
    "startup-animation",
    "web-ui",
    "deepseek",
    "深度求索",
    "鲸鱼女仆",
    "开机动画"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.2.0",
    "@smalltailqwq/dsh-client-ui-skin-maid-atelier": "^0.1.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@smalltailqwq/dsh-client-ui-skin-maid-atelier": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/client.dsh.js && node scripts/build-client.mjs --check",
    "smoke": "node scripts/smoke.mjs",
    "assert": "node scripts/assert.mjs",
    "verify": "npm run check && npm run smoke && npm run assert && npm run check:client-format",
    "pack:release": "npm pack --cache .npm-cache",
    "check:client-format": "node scripts/check-client-format.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:artwork": "node scripts/check-artwork.mjs"
  },
  "homepage": "https://github.com/Ian-Yunqi/dsh-plugin-boot-whale-maid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ian-Yunqi/dsh-plugin-boot-whale-maid.git"
  },
  "bugs": {
    "url": "https://github.com/Ian-Yunqi/dsh-plugin-boot-whale-maid/issues"
  }
}
